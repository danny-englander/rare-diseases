---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import {
  diseases,
  systems,
  inheritancePatterns,
  ageOfOnsetOptions,
  rarityOptions,
} from "../data/diseases";

// Orphadata's July 2026 release (en_product7.xml, "linearisation") lists
// 10,101 total rare diseases — see README for how the sample here relates
// to that full count.
const ORPHADATA_TOTAL = 10_101;

// Alphabetical for the initial server-rendered list; client-side search
// re-sorts the same way after every query/filter change.
const sortedDiseases = [...diseases].sort((a, b) =>
  a.name.localeCompare(b.name),
);

// Each facet group gets its own daisyUI semantic color, consistently
// applied to its pills (when selected), its header dot, and its chips
// in the active-filters row — so a chip's color alone tells you which
// group it came from, even with the panel closed. Written out in full
// (not built with template-literal interpolation like `badge-${color}`)
// because Tailwind's class scanner needs complete, literal class name
// strings somewhere in the source to generate their CSS — see the
// GROUP_COLORS mirror in the client script below, which references
// these same four color names by group key.
const FACET_COLORS = {
  primary: {
    dot: "bg-primary",
    pill: "peer-checked:badge-primary peer-checked:border-primary",
    chip: "badge-primary",
  },
  secondary: {
    dot: "bg-secondary",
    pill: "peer-checked:badge-secondary peer-checked:border-secondary",
    chip: "badge-secondary",
  },
  accent: {
    dot: "bg-accent",
    pill: "peer-checked:badge-accent peer-checked:border-accent",
    chip: "badge-accent",
  },
  info: {
    dot: "bg-info",
    pill: "peer-checked:badge-info peer-checked:border-info",
    chip: "badge-info",
  },
} as const;

// Drives the nested collapse groups inside the filter panel. The first
// two (most commonly filtered) start expanded; the rest start collapsed
// so the panel doesn't open to a wall of facets.
const facetGroups = [
  {
    key: "System",
    legend: "Body system",
    options: systems,
    defaultOpen: true,
    color: "primary" as const,
    count: (v: string) => diseases.filter((d) => d.system === v).length,
  },
  {
    key: "Inheritance",
    legend: "Inheritance pattern",
    options: inheritancePatterns,
    defaultOpen: true,
    color: "secondary" as const,
    count: (v: string) =>
      diseases.filter((d) => d.inheritance.includes(v)).length,
  },
  {
    key: "AgeOfOnset",
    legend: "Typical age of onset",
    options: ageOfOnsetOptions,
    defaultOpen: false,
    color: "accent" as const,
    count: (v: string) =>
      diseases.filter((d) => d.ageOfOnset.includes(v)).length,
  },
  {
    key: "Rarity",
    legend: "Rarity",
    options: rarityOptions,
    defaultOpen: false,
    color: "info" as const,
    count: (v: string) => diseases.filter((d) => d.rarity === v).length,
  },
];
---

<Layout title='Rare Disease Index — Search'>
  <main class='mx-auto max-w-5xl px-4 py-8 sm:px-6'>
    <div class='flex items-start justify-between gap-4'>
      <div class='flex-1'>
        <h1
          class='font-display text-2xl font-semibold tracking-tight sm:text-3xl'
        >
          Find a rare disease
        </h1>
        <p class='mt-1 text-base-content/95'>
          Search by name, synonym, or symptom. Filter by body system or
          inheritance pattern.
        </p>
      </div>
      <ThemeToggle />
    </div>

    <div
      class='collapse-arrow collapse mt-3 w-full border border-dotted border-base-content bg-base-100'
    >
      <input type='checkbox' aria-label='What is this?' />
      <div class='collapse-title flex min-h-0 items-center gap-2 py-2 text-sm font-medium text-base-content/80'>
        <Icon name='material-symbols:help-outline' class='h-4 w-4 shrink-0' />
        What is this?
      </div>
      <div class='collapse-content'>
        <p class='text-sm text-base-content/95'>
          This is a working prototype of the search interface, not a
          comprehensive database — it currently covers a sample of {
            diseases.length
          } of Orphadata's {ORPHADATA_TOTAL.toLocaleString()} catalogued rare diseases.
          Not finding something here doesn't mean it isn't real or rare.
        </p>
      </div>
    </div>

    <div class='mx-auto mt-8'>
      <label for='search-input' class='sr-only'>Search</label>
      <input
        id='search-input'
        type='search'
        placeholder='Search…'
        class='input input-bordered min-h-11 w-full border-primary focus:border-yellow-400 focus:outline-none'
        autocomplete='off'
      />

      <button
        type='button'
        id='filter-trigger'
        aria-haspopup='dialog'
        class='btn btn-outline border-primary mt-3 min-h-11 w-full justify-between font-normal'
      >
        <span class='flex items-center gap-2'>
          <svg
            class='h-4 w-4 shrink-0'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z'
            ></path>
          </svg>
          <span id='filter-trigger-label'
            >Filters · {diseases.length} results</span
          >
        </span>
        <svg
          class='h-4 w-4 shrink-0 text-base-content/50'
          xmlns='http://www.w3.org/2000/svg'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='1.5'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M8.25 4.5l7.5 7.5-7.5 7.5'></path>
        </svg>
      </button>

      <div id='active-filters' class='mt-3'></div>

      <p
        id='result-count'
        class='mt-6 text-sm text-base-content/95'
        aria-live='polite'
      >
        {diseases.length} results
      </p>
      <ul id='results-list' class='mt-2 divide-y divide-base-300'>
        {
          sortedDiseases.slice(0, 20).map((d) => (
            <li class='py-4'>
              <a
                href={`/diseases/${d.slug}/`}
                class='font-display text-lg font-medium hover:text-primary'
              >
                {d.name}
              </a>
              <p class='mt-1 text-sm text-base-content/95'>{d.note}</p>
              <p class='mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-base-content/95'>
                <span>{d.orphaCode}</span>
                <span>{d.system}</span>
                <span>{d.inheritance.join(", ")}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <div id='show-more-container' class='mt-4'></div>
    </div>
  </main>

  <dialog
    id='filter-dialog'
    aria-label='Filters'
    class='m-0 h-dvh max-h-none w-dvw max-w-none border-0 bg-transparent p-0 items-end justify-center md:items-stretch md:justify-end'
  >
    <div
      class='flex max-h-[85dvh] w-full flex-col rounded-t-box bg-base-100 shadow-xl md:h-full md:max-h-none md:w-full md:max-w-sm md:rounded-t-none md:rounded-l-box'
    >
      <div
        class='flex shrink-0 items-center justify-between border-b border-base-300 p-4'
      >
        <h2 class='font-display text-lg font-semibold'>Filters</h2>
        <button
          type='button'
          id='filter-close'
          aria-label='Close filters'
          class='btn btn-ghost btn-circle btn-sm min-h-11'
        >
          <svg
            class='h-5 w-5'
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='1.5'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M6 18L18 6M6 6l12 12'></path>
          </svg>
        </button>
      </div>

      <div class='flex-1 space-y-3 overflow-y-auto p-4'>
        {
          facetGroups.map((group) => (
            <div class='collapse-arrow collapse border border-base-300 bg-base-100'>
              <input
                type='checkbox'
                checked={group.defaultOpen}
                aria-label={group.legend}
              />
              <div class='collapse-title flex min-h-0 items-center gap-2 py-3 text-sm font-medium text-base-content/80'>
                <span
                  class={`h-2 w-2 shrink-0 rounded-full ${FACET_COLORS[group.color].dot}`}
                  aria-hidden='true'
                ></span>
                {group.legend}
              </div>
              <div class='collapse-content'>
                <div class='flex flex-wrap gap-2 pt-1'>
                  {group.options.map((value) => (
                    <label class='cursor-pointer'>
                      <input
                        type='checkbox'
                        class='peer sr-only'
                        data-facet-group={group.key}
                        data-facet-value={value}
                      />
                      <span class={`badge flex min-h-11 items-center gap-1 border border-base-300 px-3 text-sm ${FACET_COLORS[group.color].pill}`}>
                        {value}
                        <span
                          class='text-xs opacity-60'
                          data-count-for={`${group.key}:${value}`}
                        >
                          ({group.count(value)})
                        </span>
                      </span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </dialog>

  <script
    type='application/json'
    id='diseases-data'
    set:html={JSON.stringify(diseases)}
  />

  <script is:inline>
    (function () {
      var PAGE_SIZE = 20;

      // Mirrors the `color` field on each facetGroups entry in the
      // frontmatter above — the active-filter chips are built here in
      // plain client JS (not by Astro), so they need their own copy of
      // the group-to-color mapping to stay in sync with the pills.
      var GROUP_COLORS = {
        System: "primary",
        Inheritance: "secondary",
        AgeOfOnset: "accent",
        Rarity: "info",
      };

      var searchInput = document.getElementById("search-input");
      var resultsList = document.getElementById("results-list");
      var resultCount = document.getElementById("result-count");
      var showMoreContainer = document.getElementById("show-more-container");
      var activeFiltersContainer = document.getElementById("active-filters");
      var filterTrigger = document.getElementById("filter-trigger");
      var filterTriggerLabel = document.getElementById("filter-trigger-label");
      var filterDialog = document.getElementById("filter-dialog");
      var filterClose = document.getElementById("filter-close");
      var checkboxes = Array.prototype.slice.call(
        document.querySelectorAll("[data-facet-group]"),
      );

      var pagefind = null;
      var fallbackData = null;
      var currentItems = [];
      var visibleCount = PAGE_SIZE;

      filterTrigger.addEventListener("click", function () {
        filterDialog.showModal();
      });
      filterClose.addEventListener("click", function () {
        filterDialog.close();
      });
      filterDialog.addEventListener("click", function (e) {
        if (e.target === filterDialog) filterDialog.close();
      });

      function getActiveFilters() {
        var filters = {};
        checkboxes.forEach(function (cb) {
          if (cb.checked) {
            var group = cb.dataset.facetGroup;
            var value = cb.dataset.facetValue;
            filters[group] = filters[group] || [];
            filters[group].push(value);
          }
        });
        return filters;
      }

      function updateCount(group, value, count) {
        var el = document.querySelector(
          '[data-count-for="' + group + ":" + value + '"]',
        );
        if (el) el.textContent = count != null ? "(" + count + ")" : "";
      }

      function updateFilterTriggerLabel() {
        var filters = getActiveFilters();
        var activeCount = Object.keys(filters).reduce(function (sum, g) {
          return sum + filters[g].length;
        }, 0);
        var resultText =
          currentItems.length +
          " result" +
          (currentItems.length === 1 ? "" : "s");
        filterTriggerLabel.textContent =
          "Filters" +
          (activeCount ? " (" + activeCount + " active)" : "") +
          " · " +
          resultText;
      }

      // Renders one removable pill per checked facet checkbox, derived
      // straight from checkbox state — the checkboxes stay the single
      // source of truth, this is just a view over them.
      function renderActiveFilters() {
        var filters = getActiveFilters();
        var pills = [];
        Object.keys(filters).forEach(function (group) {
          filters[group].forEach(function (value) {
            pills.push({ group: group, value: value });
          });
        });

        if (!pills.length) {
          activeFiltersContainer.innerHTML = "";
          return;
        }

        var chipsHtml = pills
          .map(function (p) {
            var color = GROUP_COLORS[p.group] || "neutral";
            return (
              '<button type="button" class="badge badge-' +
              color +
              ' gap-1.5 pr-2" data-remove-filter ' +
              'data-facet-group="' +
              p.group +
              '" data-facet-value="' +
              p.value +
              '">' +
              "<span>" +
              p.value +
              "</span>" +
              '<span aria-hidden="true">×</span>' +
              '<span class="sr-only">Remove ' +
              p.value +
              " filter</span>" +
              "</button>"
            );
          })
          .join("");

        var html = '<div class="flex flex-wrap items-center gap-2">' + chipsHtml + "</div>";

        if (pills.length >= 1) {
          html +=
            '<button type="button" id="clear-filters-btn" ' +
            'class="btn btn-outline btn-sm mt-2 font-bold">' +
            "Clear all</button>";
        }

        activeFiltersContainer.innerHTML = html;

        activeFiltersContainer
          .querySelectorAll("[data-remove-filter]")
          .forEach(function (btn) {
            btn.addEventListener("click", function () {
              var group = btn.dataset.facetGroup;
              var value = btn.dataset.facetValue;
              var cb = checkboxes.filter(function (c) {
                return (
                  c.dataset.facetGroup === group &&
                  c.dataset.facetValue === value
                );
              })[0];
              if (cb) {
                cb.checked = false;
                runSearch();
              }
            });
          });

        var clearBtn = document.getElementById("clear-filters-btn");
        if (clearBtn) {
          clearBtn.addEventListener("click", function () {
            checkboxes.forEach(function (cb) {
              cb.checked = false;
            });
            runSearch();
          });
        }
      }

      function itemHtml(d) {
        return (
          '<li class="py-4">' +
          '<a href="' +
          d.url +
          '" class="font-display text-lg font-medium hover:text-primary">' +
          d.title +
          "</a>" +
          '<p class="mt-1 text-sm text-base-content/95">' +
          (d.excerpt || "") +
          "</p>" +
          '<p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-xs text-base-content/95">' +
          (d.orphaCode ? "<span>" + d.orphaCode + "</span>" : "") +
          (d.system ? "<span>" + d.system + "</span>" : "") +
          (d.inheritance ? "<span>" + d.inheritance + "</span>" : "") +
          "</p>" +
          "</li>"
        );
      }

      // Renders whatever's currently visible given `currentItems` and
      // `visibleCount`, plus a "Show more" button when there's more than
      // is currently shown. Doesn't re-run search/filtering — that's
      // runSearch's job. This just handles what's already been computed.
      function renderPage() {
        resultCount.textContent =
          currentItems.length +
          " result" +
          (currentItems.length === 1 ? "" : "s");
        updateFilterTriggerLabel();

        if (currentItems.length === 0) {
          resultsList.innerHTML =
            '<li class="py-8 text-sm text-base-content/95">' +
            "No matches in this prototype's sample — that reflects what's in the " +
            "current sample, not whether the disease is real. Try a different " +
            "spelling, a related symptom, or fewer filters." +
            "</li>";
          showMoreContainer.innerHTML = "";
          return;
        }

        var visible = currentItems.slice(0, visibleCount);
        resultsList.innerHTML = visible.map(itemHtml).join("");

        var remaining = currentItems.length - visible.length;
        if (remaining > 0) {
          var nextBatch = Math.min(PAGE_SIZE, remaining);
          showMoreContainer.innerHTML =
            '<button type="button" id="show-more-btn" class="w-full rounded-field border border-base-300 py-2 text-sm text-base-content/95 transition-colors hover:border-primary hover:text-primary">' +
            "Show " +
            nextBatch +
            " more (" +
            remaining +
            " left)" +
            "</button>";
          document
            .getElementById("show-more-btn")
            .addEventListener("click", function () {
              visibleCount += PAGE_SIZE;
              renderPage();
            });
        } else {
          showMoreContainer.innerHTML = "";
        }
      }

      function byTitle(a, b) {
        return a.title.localeCompare(b.title);
      }

      function debounce(fn, ms) {
        var timer;
        return function () {
          var args = arguments;
          clearTimeout(timer);
          timer = setTimeout(function () {
            fn.apply(null, args);
          }, ms);
        };
      }

      function runSearch() {
        var query = searchInput.value.trim();
        var filters = getActiveFilters();

        renderActiveFilters();

        if (pagefind) {
          return pagefind
            .search(query || null, { filters: filters })
            .then(function (search) {
              // No slice here — loading .data() for every match (capped in
              // the low hundreds at most, given the dataset size) is fast
              // since Pagefind reads from its already-loaded local index.
              // Paging into that full set happens in renderPage, client-side.
              return Promise.all(
                search.results.map(function (r) {
                  return r.data();
                }),
              ).then(function (results) {
                currentItems = results.map(function (d) {
                  return {
                    url: d.url,
                    title: (d.meta && d.meta.title) || d.url,
                    excerpt: (d.meta && d.meta.note) || d.excerpt,
                    orphaCode: d.meta && d.meta.orphaCode,
                    system: d.meta && d.meta.system,
                    inheritance: d.meta && d.meta.inheritance,
                  };
                });
                currentItems.sort(byTitle);
                visibleCount = PAGE_SIZE;
                renderPage();

                Object.keys(search.filters || {}).forEach(function (group) {
                  Object.entries(search.filters[group]).forEach(
                    function (entry) {
                      updateCount(group, entry[0], entry[1]);
                    },
                  );
                });
              });
            });
        }

        if (fallbackData) {
          var q = query.toLowerCase();
          var matchesQuery = function (d) {
            return (
              !q ||
              d.name.toLowerCase().indexOf(q) !== -1 ||
              d.synonyms.join(" ").toLowerCase().indexOf(q) !== -1 ||
              d.symptoms.join(" ").toLowerCase().indexOf(q) !== -1
            );
          };

          var matchesArrayFacet = function (group, values) {
            if (!filters[group] || !filters[group].length) return true;
            return values.some(function (v) {
              return filters[group].indexOf(v) !== -1;
            });
          };
          var matchesValueFacet = function (group, value) {
            if (!filters[group] || !filters[group].length) return true;
            return filters[group].indexOf(value) !== -1;
          };

          var filtered = fallbackData.filter(function (d) {
            return (
              matchesQuery(d) &&
              matchesValueFacet("System", d.system) &&
              matchesArrayFacet("Inheritance", d.inheritance) &&
              matchesArrayFacet("AgeOfOnset", d.ageOfOnset) &&
              matchesValueFacet("Rarity", d.rarity)
            );
          });

          currentItems = filtered.map(function (d) {
            return {
              url: "/diseases/" + d.slug + "/",
              title: d.name,
              excerpt: d.note,
              orphaCode: d.orphaCode,
              system: d.system,
              inheritance: d.inheritance.join(", "),
            };
          });
          currentItems.sort(byTitle);
          visibleCount = PAGE_SIZE;
          renderPage();

          // Simplified dev-only counts: reflects the query alone, not
          // combined with other active facets. The real Pagefind API
          // (used in the built site) computes these properly.
          Array.from(
            new Set(
              fallbackData.map(function (d) {
                return d.system;
              }),
            ),
          ).forEach(function (s) {
            updateCount(
              "System",
              s,
              fallbackData.filter(function (d) {
                return d.system === s && matchesQuery(d);
              }).length,
            );
          });
          Array.from(
            new Set(
              fallbackData.reduce(function (acc, d) {
                return acc.concat(d.inheritance);
              }, []),
            ),
          ).forEach(function (i) {
            updateCount(
              "Inheritance",
              i,
              fallbackData.filter(function (d) {
                return d.inheritance.indexOf(i) !== -1 && matchesQuery(d);
              }).length,
            );
          });
          Array.from(
            new Set(
              fallbackData.reduce(function (acc, d) {
                return acc.concat(d.ageOfOnset);
              }, []),
            ),
          ).forEach(function (a) {
            updateCount(
              "AgeOfOnset",
              a,
              fallbackData.filter(function (d) {
                return d.ageOfOnset.indexOf(a) !== -1 && matchesQuery(d);
              }).length,
            );
          });
          Array.from(
            new Set(
              fallbackData.map(function (d) {
                return d.rarity;
              }),
            ),
          ).forEach(function (r) {
            updateCount(
              "Rarity",
              r,
              fallbackData.filter(function (d) {
                return d.rarity === r && matchesQuery(d);
              }).length,
            );
          });
        }
        return Promise.resolve();
      }

      function init() {
        import(/* @vite-ignore */ "/pagefind/pagefind.js")
          .then(function (mod) {
            return mod
              .init()
              .then(function () {
                return mod.filters();
              })
              .then(function () {
                pagefind = mod;
              });
          })
          .catch(function (e) {
            console.warn(
              "[rare-disease-search] Pagefind index not found — this is expected under `astro dev`. " +
                "Run `npm run build` to generate the search index. Falling back to an in-memory demo search.",
              e,
            );
            var dataEl = document.getElementById("diseases-data");
            fallbackData = JSON.parse((dataEl && dataEl.textContent) || "[]");
          })
          .then(function () {
            searchInput.addEventListener("input", debounce(runSearch, 150));
            checkboxes.forEach(function (cb) {
              cb.addEventListener("change", runSearch);
            });
            // Establishes the JS-paginated view immediately (replacing the
            // server-rendered first-20 list with the live-search-backed
            // one) rather than waiting for the first user interaction.
            runSearch();
          });
      }

      init();
    })();
  </script>
</Layout>
