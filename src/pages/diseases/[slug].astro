---
import Layout from "../../layouts/Layout.astro";
import { diseases } from "../../data/diseases";

export function getStaticPaths() {
  return diseases.map((disease) => ({
    params: { slug: disease.slug },
    props: { disease },
  }));
}

const { disease } = Astro.props;
---

<Layout
  title={`${disease.name} — Rare Disease Index`}
  description={disease.note}
>
  <main class='mx-auto max-w-3xl px-4 py-10 sm:px-6'>
    <a
      href='/'
      data-pagefind-ignore
      class='text-base text-primary hover:underline'>&larr; Back to search</a
    >

    <article class='mt-6' data-pagefind-body>
      <p
        class='text-base text-base-content/95'
        data-pagefind-meta={`orphaCode:${disease.orphaCode}`}
      >
        {disease.orphaCode}
      </p>
      <h1
        class='font-display mt-1 text-4xl font-semibold tracking-tight sm:text-5xl'
      >
        {disease.name}
      </h1>
      {
        disease.synonyms.length > 0 && (
          <p class='mt-2 text-base-content/95'>
            Also called {disease.synonyms.join(", ")}
          </p>
        )
      }

      <dl
        class='mt-8 grid grid-cols-1 gap-x-8 gap-y-4 border-y border-base-300 py-6 sm:grid-cols-2'
      >
        <div>
          <dt class='text-sm text-base-content/95'>Body system</dt>
          <dd
            class='mt-1'
            data-pagefind-filter={`System:${disease.system}`}
            data-pagefind-meta={`system:${disease.system}`}
          >
            {disease.system}
          </dd>
        </div>
        <div>
          <dt class='text-sm text-base-content/95'>Inheritance pattern</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`inheritance:${disease.inheritance.join(", ")}`}
          >
            {
              disease.inheritance.map((pattern, i) => (
                <span data-pagefind-filter={`Inheritance:${pattern}`}>
                  {pattern}
                  {i < disease.inheritance.length - 1 ? ", " : ""}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class='text-sm text-base-content/95'>Typical age of onset</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`ageOfOnset:${disease.ageOfOnset.join(", ")}`}
          >
            {
              disease.ageOfOnset.map((onset, i) => (
                <span data-pagefind-filter={`AgeOfOnset:${onset}`}>
                  {onset}
                  {i < disease.ageOfOnset.length - 1 ? ", " : ""}
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt class='text-sm text-base-content/95'>Estimated prevalence</dt>
          <dd
            class='mt-1'
            data-pagefind-meta={`prevalence:${disease.prevalence}`}
          >
            {disease.prevalence}
          </dd>
        </div>
        <div>
          <dt class='text-sm text-base-content/95'>Rarity class</dt>
          <dd
            class='mt-1'
            data-pagefind-filter={`Rarity:${disease.rarity}`}
            data-pagefind-meta={`rarity:${disease.rarity}`}
          >
            {disease.rarity}
          </dd>
        </div>
      </dl>

      <p
        class='mt-8 leading-relaxed'
        data-pagefind-meta={`note:${disease.note}`}
      >
        {disease.note}
      </p>

      <div class='mt-8'>
        <h2 class='text-base font-medium text-base-content/95'>Common signs</h2>
        <ul class='mt-3 flex flex-wrap gap-2'>
          {
            disease.symptoms.map((symptom) => (
              <li class='rounded-field border border-base-300 px-3 py-1 text-base'>
                {symptom}
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </main>
</Layout>
