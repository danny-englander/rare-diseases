---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import MainNav from "../components/MainNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { dataVersion } from "../data/diseases";
import navItems from "../data/navigation.json";
import {
  commitShortSha,
  commitUrl,
  commitDate,
  repoUrl,
} from "../data/build-info";

const formattedCommitDate = commitDate
  ? new Date(commitDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Rare disease search prototype built on Orphanet data.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonicalURL} />
    <meta name='theme-color' content='#faf8f4' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#0f172a' media='(prefers-color-scheme: dark)' />

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='Rare Zebra' />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:image' content={ogImageURL} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content='Rare Zebra' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImageURL} />

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap'
      rel='stylesheet'
    />
    <script is:inline>
      /* Apply any saved theme before first paint, to avoid a flash of the
         wrong theme. Falls back to the CSS prefers-color-scheme default. */
      try {
        const saved = localStorage.getItem("theme");
        if (saved) document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    </script>
  </head>
  <body class='min-h-screen bg-base-100 text-base-content'>
    <header data-pagefind-ignore class='border-b border-base-300'>
      <div class='mx-auto max-w-5xl px-4 pt-4 sm:px-6'>
        <div class='flex items-center justify-between gap-4'>
          <a
            href='/'
            class='flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-base-content hover:text-primary focus-visible:text-primary'
          >
            <Logo
              class='h-[30px] w-[30px] text-primary md:h-[50px] md:w-[50px]'
            />
            Rare Zebra
          </a>
          <div class='flex items-center gap-1'>
            <ThemeToggle />
            <MainNav />
          </div>
        </div>
        <p class='mt-1 pb-3 text-sm text-base-content/80'>
          Rare disease search prototype built on Orphanet data
        </p>
      </div>
    </header>
    <slot />
    <footer data-pagefind-ignore class='mt-8 border-t border-base-300'>
      <div class='mx-auto max-w-5xl px-4 py-10 sm:px-6'>
        <div class='grid grid-cols-1 gap-10 md:grid-cols-3'>
          <div>
            <a
              href='/'
              class='flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-base-content hover:text-primary focus-visible:text-primary'
            >
              <Logo class='h-[30px] w-[30px] text-primary' />
              Rare Zebra
            </a>
            <div class='mt-3 space-y-2 text-base text-base-content/95'>
              <p>
                This is a prototype. Disease summaries are simplified and
                not a substitute for medical advice.
              </p>
              <p>
                Orphadata: Free access data from Orphanet. <a
                  href='https://www.orphadata.com/'
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'>https://www.orphadata.com</a
                >. Data release {dataVersion}. Licensed <a
                  href='https://creativecommons.org/licenses/by/4.0/'
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'>CC BY 4.0</a
                >. This site's code is a separate, independently built
                interface over that data, not an Orphanet product.
              </p>
            </div>
          </div>

          <div>
            <h2
              class='font-display text-base font-semibold tracking-wide text-base-content/70 uppercase'
            >
              Menu
            </h2>
            <ul class='mt-3 space-y-2 text-base'>
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2
              class='font-display text-base font-semibold tracking-wide text-base-content/70 uppercase'
            >
              Build
            </h2>
            <div class='mt-3 space-y-1 text-base text-base-content/95'>
              {
                commitShortSha && (
                  <p>
                    Latest commit:{" "}
                    <a
                      href={commitUrl}
                      class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'
                    >
                      {commitShortSha}
                    </a>
                    {formattedCommitDate && ` · ${formattedCommitDate}`}
                  </p>
                )
              }
              <p>
                <a
                  href={repoUrl}
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'
                >
                  View source on GitHub
                </a>
              </p>
            </div>
            <ul class='mt-3 list-disc space-y-1 pl-4 text-base text-base-content/95'>
              <li>
                Built with <a
                  href='https://astro.build/'
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'>Astro</a
                >
              </li>
              <li>
                Hosted on <a
                  href='https://www.netlify.com/'
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'>Netlify</a
                >
              </li>
              <li>
                Search by <a
                  href='https://pagefind.app/'
                  target='_blank'
                  rel='noopener'
                  class='text-primary underline hover:text-[var(--color-link-hover)] focus-visible:text-[var(--color-link-hover)]'>Pagefind</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>
    </footer>
    <script>
      import { themeChange } from "theme-change";
      themeChange();
    </script>
  </body>
</html>
