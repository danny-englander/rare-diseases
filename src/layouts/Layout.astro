---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import MainNav from "../components/MainNav.astro";
import { dataVersion } from "../data/diseases";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "A reference tool for looking up rare diseases.",
} = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <title>{title}</title>
    <meta name='description' content={description} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap'
      rel='stylesheet'
    />
    <script is:inline>
      /* Apply any saved theme before first paint, to avoid a flash of the
         wrong theme. Falls back to the CSS prefers-color-scheme default. */
      try {
        const saved = localStorage.getItem("theme");
        if (saved) document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    </script>
  </head>
  <body class='min-h-screen bg-base-100 text-base-content'>
    <header data-pagefind-ignore class='border-b border-base-300'>
      <div class='mx-auto max-w-5xl px-4 pt-4 sm:px-6'>
        <div class='flex items-center justify-between gap-4'>
          <a
            href='/'
            class='flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-base-content'
          >
            <Logo
              class='h-[30px] w-[30px] text-primary md:h-[50px] md:w-[50px]'
            />
            Rare Disease Index
          </a>
          <MainNav />
        </div>
        <p class='mt-1 pb-3 text-sm text-base-content/80'>
          A prototype search interface built on Orphanet data
        </p>
      </div>
    </header>
    <slot />
    <footer data-pagefind-ignore class='mt-16 border-t border-base-300'>
      <div
        class='mx-auto max-w-5xl space-y-2 px-4 py-8 text-sm text-base-content/95 sm:px-6'
      >
        <p>
          This is a prototype. Disease summaries are simplified and not a
          substitute for medical advice.
        </p>
        <p>
          Orphadata: Free access data from Orphanet. <a
            href='https://www.orphadata.com/'
            target='_blank'
            rel='noopener'
            class='underline hover:text-primary'>https://www.orphadata.com</a
          >. Data release {dataVersion}. Licensed <a
            href='https://creativecommons.org/licenses/by/4.0/'
            target='_blank'
            rel='noopener'
            class='underline hover:text-primary'>CC BY 4.0</a
          > — this site's code is a separate, independently built interface over that
          data, not an Orphanet product.
        </p>
      </div>
    </footer>
    <script>
      import { themeChange } from "theme-change";
      themeChange();
    </script>
  </body>
</html>
