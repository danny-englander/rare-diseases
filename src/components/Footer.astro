---
import Logo from "./Logo.astro";
import { dataVersion } from "../data/diseases";
import navItems from "../data/navigation.json";
import {
  commitShortSha,
  commitUrl,
  commitDate,
  repoUrl,
} from "../data/build-info";

const formattedCommitDate = commitDate
  ? new Date(commitDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";
---

<footer data-pagefind-ignore class='mt-8 border-t border-base-300'>
  <div class='mx-auto max-w-5xl px-4 py-10 sm:px-6'>
    <div class='grid grid-cols-1 gap-10 md:grid-cols-3'>
      <div>
        <a
          href='/'
          class='flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-base-content hover:text-primary focus-visible:text-primary'
        >
          <Logo class='h-[30px] w-[30px] text-primary' />
          Rare Zebra
        </a>
        <div class='mt-3 space-y-2 text-base text-base-content/95'>
          <p>
            This is a prototype. Disease summaries are simplified and not a
            substitute for medical advice.
          </p>
          <p>
            Orphadata: Free access data from Orphanet. <a
              href='https://www.orphadata.com/'
              target='_blank'
              rel='noopener'
              class='inline-link'
              >https://www.orphadata.com</a
            >. Data release {dataVersion}. Licensed <a
              href='https://creativecommons.org/licenses/by/4.0/'
              target='_blank'
              rel='noopener'
              class='inline-link'
              >CC BY 4.0</a
            >.
          </p>
          <p>
            This site's code is a separate, independently built interface
            over that data, not an Orphanet product.
          </p>
        </div>
      </div>

      <div class='md:w-fit md:justify-self-center'>
        <h2
          class='font-display text-base font-semibold tracking-wide text-base-content/70 uppercase'
        >
          Menu
        </h2>
        <ul class='mt-3 space-y-2 text-base'>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class='inline-link'
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class='font-display text-base font-semibold tracking-wide text-base-content/70 uppercase'
        >
          Build
        </h2>
        <div class='mt-3 space-y-1 text-base text-base-content/95'>
          {
            commitShortSha && (
              <p>
                Latest commit:{" "}
                <a
                  href={commitUrl}
                  class='inline-link'
                >
                  {commitShortSha}
                </a>
                {formattedCommitDate && ` · ${formattedCommitDate}`}
              </p>
            )
          }
          <p>
            <a
              href={repoUrl}
              target='_blank'
              rel='noopener'
              class='inline-link inline-flex items-center gap-1.5'
            >
              <svg
                class='h-4 w-4 shrink-0'
                viewBox='0 0 24 24'
                fill='currentColor'
                aria-hidden='true'
              >
                <path
                  d='M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
                ></path>
              </svg>
              View source on GitHub
            </a>
          </p>
        </div>
        <ul
          class='mt-3 list-disc space-y-1 pl-4 text-base text-base-content/95'
        >
          <li>
            Built with <a
              href='https://astro.build/'
              target='_blank'
              rel='noopener'
              class='inline-link'
              >Astro</a
            >
          </li>
          <li>
            Hosted on <a
              href='https://www.netlify.com/'
              target='_blank'
              rel='noopener'
              class='inline-link'
              >Netlify</a
            >
          </li>
          <li>
            Search by <a
              href='https://pagefind.app/'
              target='_blank'
              rel='noopener'
              class='inline-link'
              >Pagefind</a
            >
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>
