---
import Logo from "./Logo.astro";
import MainNav from "./MainNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header data-pagefind-ignore class='border-b border-base-300'>
  <div class='mx-auto max-w-5xl px-4 pt-4 sm:px-6'>
    <div class='flex items-center justify-between gap-4'>
      <a
        href='/'
        class='flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-base-content hover:text-primary focus-visible:text-primary'
      >
        <Logo class='h-[30px] w-[30px] text-primary md:h-[50px] md:w-[50px]' />
        Rare Zebra
      </a>
      <div class='flex items-center gap-1'>
        <ThemeToggle />
        <MainNav />
      </div>
    </div>
    <p class='mt-1 pb-3 text-sm text-base-content/80'>
      Rare disease search prototype built on Orphanet data
    </p>
  </div>
</header>
